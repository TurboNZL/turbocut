{
  "name": "turbocut",
  "version": "2026.10.1",
  "description": "TurboCut: a lightweight, cross-platform multi-track video editor with built-in auto captions.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs && node e2e/app.mjs && node e2e/settings.mjs && node e2e/bin.mjs && node e2e/keys.mjs && node e2e/styles.mjs && node e2e/touch.mjs",
    "e2e:electron": "node e2e/electron.mjs",
    "e2e:touch": "node e2e/touch.mjs",
    "e2e:settings": "node e2e/settings.mjs",
    "e2e:bin": "node e2e/bin.mjs",
    "e2e:keys": "node e2e/keys.mjs",
    "e2e:styles": "node e2e/styles.mjs",
    "electron:dev": "TURBOCUT_DEV_URL=http://localhost:5173 electron .",
    "dist:desktop": "pnpm build && electron-builder --publish never",
    "android:sync": "pnpm build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@huggingface/transformers": "^4.3.1",
    "@mediabunny/aac-encoder": "^1.61.4",
    "@types/node": "^22.10.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "mediabunny": "^1.61.3",
    "playwright-core": "^1.64.0",
    "turbothemes": "git+https://github.com/TurboNZL/turbothemes.git",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "main": "electron/main.cjs",
  "packageManager": "pnpm@10.28.0",
  "author": {
    "name": "TurboNZL",
    "email": "turbonzl@users.noreply.github.com"
  },
  "homepage": "https://github.com/TurboNZL/turbocut",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.turbonzl.turbocut",
    "productName": "TurboCut",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TurboCut-${version}-windows-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "TurboNZL <turbonzl@users.noreply.github.com>",
      "artifactName": "TurboCut-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "TurboCut-${version}-windows-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "TurboNZL",
      "repo": "turbocut",
      "releaseType": "prerelease"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
